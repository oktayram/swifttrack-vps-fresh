# SwiftTrack Production Environment
# Hostinger VPS: 153.92.221.140

# Node Environment
NODE_ENV=production

# Server Port (Internal)
PORT=5000

# MongoDB Connection (Yerel MongoDB - VPS üzerinde)
# Eğer MongoDB Atlas kullanmak isterseniz, alttaki yorum satırını açın
MONGODB_URI=mongodb://localhost:27017/swifttrack
# MONGODB_URI=mongodb+srv://kullanici:sifre@cluster.mongodb.net/swifttrack?retryWrites=true&w=majority

# JWT Secret (Güçlü bir şifre kullanın!)
JWT_SECRET=swifttrack_hostinger_vps_2024_secure_key_change_this

# API Base URL (VPS IP)
API_URL=http://153.92.221.140/api

# Frontend URL
FRONTEND_URL=http://153.92.221.140

# CORS Origins (güvenlik için spesifik domainler ekleyin)
CORS_ORIGINS=http://153.92.221.140,http://localhost:3000

# Log Level
LOG_LEVEL=info

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
