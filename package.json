{
  "name": "swifttrack-backend",
  "version": "1.0.0",
  "description": "SwiftTrack Koerier Backend API - Hostinger VPS",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "seed": "node seed.js",
    "deploy": "pm2 start ecosystem.config.js --env production",
    "restart": "pm2 restart swifttrack-api",
    "stop": "pm2 stop swifttrack-api",
    "logs": "pm2 logs swifttrack-api",
    "monitor": "pm2 monit",
    "status": "pm2 status"
  },
  "dependencies": {
    "express": "^4.18.2",
    "mongoose": "^7.5.0",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "bcryptjs": "^2.4.3",
    "jsonwebtoken": "^9.0.2",
    "express-validator": "^7.0.1",
    "socket.io": "^4.7.2",
    "morgan": "^1.10.0",
    "express-rate-limit": "^6.10.0",
    "helmet": "^7.0.0"
  },
  "devDependencies": {
    "nodemon": "^3.0.1"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  }
}
